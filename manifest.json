{
  "manifest_version": 2,
  "name": "Reading Width for Thunderbird",
  "description": "Set a comfortable maximum width for displayed email messages.",
  "version": "1.0.0",
  "browser_specific_settings": {
    "gecko": {
      "id": "reading-width@local",
      "strict_min_version": "128.0"
    }
  },
  "permissions": [
    "messagesModify",
    "storage"
  ],
  "background": {
    "scripts": ["background.js"]
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true,
    "browser_style": false
  }
}